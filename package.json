{
  "name": "@helix-x/db-manager",
  "version": "0.1.0",
  "description": "Numbered-SQL schema migrations with a ledger, and plain-SQL export and import, for PostgreSQL and SQLite -- with an interactive CLI.",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "db-manager": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "typedoc",
    "clean": "rm -rf dist docs",
    "prepack": "npm run clean && npm run build",
    "publish:npm": "node .github/scripts/publish.mjs npm",
    "publish:custom": "node .github/scripts/publish.mjs custom",
    "publish:both": "node .github/scripts/publish.mjs both",
    "publish:dry": "DRY_RUN=1 node .github/scripts/publish.mjs both",
    "publish:check": "node .github/scripts/publish.mjs --check both",
    "publish:copy": "node .github/scripts/publish.mjs --version",
    "registry:login": "npm config set --location=user //packages.allquill.com/repository/allquill-npm/:_auth \"${NPM_TOKEN:?set NPM_TOKEN to the base64 of user:password}\""
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.4",
    "dotenv": "^16.6.1"
  },
  "peerDependencies": {
    "pg": "^8.11.0",
    "sqlite3": "^5.1.6",
    "typeorm": "^0.3.20"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "pg": "^8.16.3",
    "sqlite3": "^5.1.7",
    "tsup": "^8.5.0",
    "typedoc": "^0.28.20",
    "typeorm": "~0.3.25",
    "typescript": "~5.7.2",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "migrations",
    "postgres",
    "sqlite",
    "typeorm",
    "pg_dump",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suryakand/db-manager.git"
  },
  "homepage": "https://suryakand.github.io/db-manager/",
  "bugs": {
    "url": "https://github.com/suryakand/db-manager/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
