# Copy to .env. db-manager reads it; a variable already set in the shell wins.

# sqlite: the file is DATABASE_FOLDER/example.sqlite (sqlite.fileName in the config)
DATABASE_TYPE=sqlite
DATABASE_FOLDER=database

# postgres
# DATABASE_TYPE=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USER=postgres
# DATABASE_PASSWORD=change-me
# DATABASE_DBNAME=example

# The first administrator, when there is no terminal to ask on (CI, a container)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-1
